p_ma <- ggplot(df_merged, aes(x = log10(meanTPM_day2 + 1), y = log2FoldChange)) +
geom_rect(data = bg_data, aes(xmin = xmin, xmax = xmax, ymin = -Inf, ymax = Inf, fill = fill_color), alpha = 0.3, inherit.aes = FALSE) +
scale_fill_identity() + geom_hline(yintercept = 0, linetype = "dashed", color = "black", size = 0.5) +
geom_point(alpha = 0.2, size = 1, aes(color = significant)) + scale_color_manual(values = c("blue", "gray", "red")) +
geom_smooth(method = "lm", se = TRUE, color = "black", linewidth = 0.8) +
geom_text(data = label_data_TPM, aes(x = x, y = y, label = label), color = label_data_TPM$color, inherit.aes = FALSE, hjust = 0, vjust = 1, size = 3.5) +
theme_classic()
p_ma
# 📊 OUTPUT 2: MA Plot (TPM)
label_data_TPM <- df_merged %>% dplyr::count(significant) %>% filter(significant %in% c("up", "down")) %>%
mutate(label = paste0(significant, ": ", n),
x = max(log10(df_merged$meanTPM_day2 + 1), na.rm = TRUE) - 2,
y = ifelse(significant == "up", max(df_merged$log2FoldChange, na.rm = TRUE) - 1, min(df_merged$log2FoldChange, na.rm = TRUE) + 1),
color = ifelse(significant == "up", "red", "blue"))
# 🌟 修正ポイント1: bg_dataに 0~0.5の区間を追加し、新しく「alpha_val」列を作る
bg_data <- data.frame(
xmin       = c(0, 0.5, 1.5, 2.5),
xmax       = c(0.5, 1.5, 2.5, 3.5),
fill_color = c("lightblue", "lightblue", "lightgray", "lightpink"),
alpha_val  = c(0.7, 0.3, 0.3, 0.3)  # 0~0.5は0.7、他は0.3を指定！
)
p_ma <- ggplot(df_merged, aes(x = log10(meanTPM_day2 + 1), y = log2FoldChange)) +
# 🌟 修正ポイント2: aesの中に alpha = alpha_val を入れ、固定の alpha = 0.3 は外す
geom_rect(data = bg_data, aes(xmin = xmin, xmax = xmax, ymin = -Inf, ymax = Inf, fill = fill_color, alpha = alpha_val), inherit.aes = FALSE) +
# 🌟 修正ポイント3: scale_alpha_identity() を追加して、数値をそのまま透明度として認識させる
scale_fill_identity() +
scale_alpha_identity() +
geom_hline(yintercept = 0, linetype = "dashed", color = "black", size = 0.5) +
geom_point(alpha = 0.2, size = 1, aes(color = significant)) +
scale_color_manual(values = c("blue", "gray", "red")) +
geom_smooth(method = "lm", se = TRUE, color = "black", linewidth = 0.8) +
geom_text(data = label_data_TPM, aes(x = x, y = y, label = label), color = label_data_TPM$color, inherit.aes = FALSE, hjust = 0, vjust = 1, size = 3.5) +
theme_classic()
p_ma
ggsave(file.path(plot_out_dir, "MA_plot_TPM_nonspikein_significant.pdf"), plot = p_ma, width = 4, height = 4)
ggsave(file.path(plot_out_dir, "MA_plot_TPM_significant.pdf"), plot = p_ma, width = 4, height = 4)
