# tile_label = ifelse(chr_name %in% c("chrX", "chrY") | is.na(mean_log2FC), "no gene", ""),
plot_row = factor(case_when(chr_name %in% c("all", paste0("chr", 1:8)) ~ "Row 1", chr_name %in% paste0("chr", 9:16) ~ "Row 2", TRUE ~ "Row 3"), levels = c("Row 1", "Row 2", "Row 3"))) %>% complete(chr_name, Contrast)
p_heatmap <- ggplot(df_heatmap_data, aes(x = chr_name, y = Contrast, fill = mean_log2FC)) + geom_tile(color = "white") +
scale_fill_gradient2(low = "blue", mid = "white", high = "red", midpoint = 0, na.value = "grey90", oob = scales::squish) +
scale_x_discrete(position = "top") + scale_y_discrete(limits = rev) +
geom_text(aes(label = ifelse(p.signif == "ns", "", p.signif)), color = "black", size = 5, vjust = 0.7) +
geom_text(aes(label = tile_label), color = "black", size = 3) + facet_wrap(~ plot_row, ncol = 1, scales = "free_x") +
theme_minimal() + theme(axis.text.x = element_text(hjust = 0.5), panel.grid = element_blank(), axis.title = element_blank(), strip.background = element_blank(), strip.text = element_blank())
p_heatmap
